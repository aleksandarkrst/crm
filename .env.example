# Production configuration for docker-compose.yml. On the server: /opt/crm/.env (chmod 600).
# Never commit the real file. Generate secrets with:  openssl rand -hex 32
# Use hex/alphanumeric passwords — they are embedded in connection URLs.

# --- Images (set by scripts/deploy.sh) ---
IMAGE_PREFIX=ghcr.io/your-github-user/crm
APP_VERSION=latest
# Staging only (docs/DEPLOYMENT.md, "Staging"): COMPOSE_PROJECT_NAME=crm-staging, FRONTEND_VARIANT=-staging
# FRONTEND_VARIANT=

# --- Database ---
POSTGRES_DB=app
POSTGRES_USER=app_admin
POSTGRES_PASSWORD=
APP_DB_USER=app_runtime
APP_DB_PASSWORD=

# --- Authentication (external OIDC identity provider) ---
AUTH_MODE=oidc
OIDC_ISSUER=https://your-tenant.eu.auth0.com/
OIDC_AUDIENCE=https://app.yourdomain.com/api
OIDC_CLIENT_ID=

# --- App URL and secret ---
# The public address, used for links in emails (invitations, daily digests).
APP_URL=https://app.yourdomain.com
# Encrypts invite links at rest (openssl rand -hex 32). Changing it breaks "Resend" and "Copy link"
# for invitations sent before the change (withdraw and invite again).
APP_SECRET=

# --- Email (sent by the worker) ---
# smtp = any SMTP provider (Postmark, Resend, SES, Mailgun, ...). log = only write emails to the
# worker's log: nothing is delivered, although the Team tab shows invitations as sent. Switch to
# smtp once the provider is set up (docs/DEPLOYMENT.md, "Email"); smtp without SMTP_URL won't start.
MAIL_DRIVER=log
# smtps://USER:PASSWORD@host:465 or smtp://USER:PASSWORD@host:587 (URL-encode special characters)
SMTP_URL=
# The sender; its domain must be verified with the provider (SPF/DKIM).
MAIL_FROM=Cadence <no-reply@yourdomain.com>
# Optional: retries of a failed send (default 4, backoff from 30 s).
# MAIL_RETRY_LIMIT=4
# MAIL_RETRY_DELAY_SECONDS=30

# --- Cloudflare Tunnel (Zero Trust → Networks → Tunnels → your tunnel → token) ---
CLOUDFLARE_TUNNEL_TOKEN=

# --- Backups ---
BACKUP_INTERVAL_HOURS=24
BACKUP_RETENTION_DAYS=14
# rclone remote:path for off-server copies, e.g. "offsite-crypt:crm". Configure the remote in
# infra/backup/rclone.conf (see docs/DEPLOYMENT.md). Empty = local copies only (not enough!).
BACKUP_RCLONE_REMOTE=

# --- Monitoring and alerts (docs/DEPLOYMENT.md, "Monitoring and alerts") ---
# Better Stack heartbeat URLs. The backup reports after every run, the disk check every hour;
# Better Stack alerts on a failure report or when reports stop. Empty = no alerts.
BACKUP_HEARTBEAT_URL=
DISK_HEARTBEAT_URL=
# The disk check reports a failure from this much use (percent).
DISK_ALERT_PERCENT=85
# Sentry DSN of the backend project (EU region). Empty = error tracking off.
SENTRY_DSN=
# Environment name on errors from this server: production or staging.
SENTRY_ENVIRONMENT=production

LOG_LEVEL=info
CORS_ORIGINS=

# Memory limits of the api and worker containers (CD-104); a container that goes over is
# restarted. Defaults fit a 4 GB server next to PostgreSQL.
# API_MEM_LIMIT=768m
# WORKER_MEM_LIMIT=768m
