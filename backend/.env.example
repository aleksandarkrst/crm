# Local development (npm run dev). Copy to .env — never commit .env.
# Matches the dev database from ../docker-compose.dev.yml.

NODE_ENV=development
PORT=3000
LOG_LEVEL=debug

# Runtime role: not the table owner, so row-level security applies.
DATABASE_URL=postgres://app_runtime:dev_runtime_password@localhost:5432/app
# Owner role: migrations and drizzle-kit only.
MIGRATION_DATABASE_URL=postgres://app_admin:dev_admin_password@localhost:5432/app
# Per-session limits on the runtime pool, in ms (0 = off). Defaults: 30000 and 60000.
# DATABASE_STATEMENT_TIMEOUT_MS=30000
# DATABASE_IDLE_IN_TRANSACTION_TIMEOUT_MS=60000

# dev = passwordless /api/auth/dev-login. Switch to oidc with a real identity provider.
AUTH_MODE=dev
DEV_JWT_SECRET=change-me-to-any-local-random-string-32chars+
# AUTH_MODE=oidc
# OIDC_ISSUER=https://your-tenant.eu.auth0.com/
# OIDC_AUDIENCE=https://api.yourdomain.com
# Creating an account with email (CD-114) in oidc mode: an Auth0 Machine-to-Machine application with
# create:users on the Management API. Dev mode creates accounts without it.
# AUTH0_MANAGEMENT_DOMAIN=your-tenant.eu.auth0.com
# AUTH0_MANAGEMENT_CLIENT_ID=
# AUTH0_MANAGEMENT_CLIENT_SECRET=
# AUTH0_DB_CONNECTION=Username-Password-Authentication
# AUTH_GOOGLE_CONNECTION=google-oauth2

# API rate limits (429 over the limit). false only for test runs, which sign in constantly.
# RATE_LIMIT_ENABLED=true

CORS_ORIGINS=
# Uploaded document templates and generated documents, one folder per workspace. The API and the
# worker must use the same folder (in production: the app_storage volume, backed up with the database).
STORAGE_DIR=./storage

# Public address of the web app, for links in emails (invitations, digests). Never taken from the request.
APP_URL=http://localhost:5173
# Encrypts invite links at rest so they can be emailed again. Required in production (openssl rand -hex 32);
# development falls back to DEV_JWT_SECRET.
# APP_SECRET=

# Email (sent by the worker). "log" writes each email to the log and, outside production, to
# $STORAGE_DIR/dev-mail/outbox.jsonl, which GET /api/dev/mail shows (dev auth only). Addresses at the
# reserved .invalid domain fail, to try failed sends. "smtp" sends through any SMTP provider
# (Postmark, Resend, SES, Mailgun, ...).
MAIL_DRIVER=log
# SMTP_URL=smtps://USER:PASSWORD@smtp.example.com:465
MAIL_FROM=Cadence <no-reply@localhost>
# A failed send is retried this many times, with exponential backoff from the delay.
# MAIL_RETRY_LIMIT=4
# MAIL_RETRY_DELAY_SECONDS=30
